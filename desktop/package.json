{
  "name": "kanga-toolkit",
  "version": "1.0.0",
  "description": "Kanga Toolkit — il coltellino svizzero per Android (app desktop Windows/macOS/Linux)",
  "main": "main.js",
  "author": "Kanga Toolkit",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "fetch-adb": "node scripts/fetch-adb.js",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.kanga.toolkit",
    "productName": "Kanga Toolkit",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "scripts/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../core",
        "to": "app-ui",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
